+bool TranslatorVisitor::asimd_VQRSHL(bool U, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool Q, bool M, size_t Vm) {
+    if (Q && (mcl::bit::get_bit<0>(Vd) || mcl::bit::get_bit<0>(Vn) || mcl::bit::get_bit<0>(Vm))) {
+        return UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(Q, Vd, D);
+    const auto m = ToVector(Q, Vm, M);
+    const auto n = ToVector(Q, Vn, N);
+
+    const auto reg_m = ir.GetVector(m);
+    const auto reg_n = ir.GetVector(n);
+
+    // The shift amount is the signed bottom byte of each element of n. Left shifts saturate
+    // (rounding does not apply); right shifts round and cannot overflow.
+    const auto shift = esize == 8 ? reg_n
+                                  : ir.VectorArithmeticShiftRight(esize, ir.VectorLogicalShiftLeft(esize, reg_n, static_cast<u8>(esize - 8)), static_cast<u8>(esize - 8));
+    const auto is_right = ir.VectorGreaterSigned(esize, ir.ZeroVector(), shift);
+    const auto saturated = U ? ir.VectorUnsignedSaturatedShiftLeft(esize, reg_m, reg_n)
+                             : ir.VectorSignedSaturatedShiftLeft(esize, reg_m, reg_n);
+    const auto rounded = U ? ir.VectorRoundingShiftLeftUnsigned(esize, reg_m, reg_n)
+                           : ir.VectorRoundingShiftLeftSigned(esize, reg_m, reg_n);
+    const auto result = ir.VectorOr(ir.VectorAnd(rounded, is_right), ir.VectorAndNot(saturated, is_right));
+
+    ir.SetVector(d, result);
+    return true;
+}
