+// VADDHN, VRADDHN, VSUBHN, VRSUBHN: the high half of each wide sum or difference, narrowed.
+bool NarrowHighHalf(TranslatorVisitor& v, bool round, bool subtract, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return v.DecodeError();
+    }
+
+    if (mcl::bit::get_bit<0>(Vn) || mcl::bit::get_bit<0>(Vm)) {
+        return v.UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(false, Vd, D);
+    const auto n = ToVector(true, Vn, N);
+    const auto m = ToVector(true, Vm, M);
+
+    const auto reg_n = v.ir.GetVector(n);
+    const auto reg_m = v.ir.GetVector(m);
+    auto wide = subtract ? v.ir.VectorSub(2 * esize, reg_n, reg_m)
+                         : v.ir.VectorAdd(2 * esize, reg_n, reg_m);
+    if (round) {
+        wide = v.ir.VectorAdd(2 * esize, wide, v.ir.VectorBroadcast(2 * esize, v.I(2 * esize, u64{1} << (esize - 1))));
+    }
+    const auto high = v.ir.VectorLogicalShiftRight(2 * esize, wide, static_cast<u8>(esize));
+
+    v.ir.SetVector(d, v.ir.VectorNarrow(2 * esize, high));
+    return true;
+}
