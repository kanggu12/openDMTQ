// OpenDMTQ.exe's icon and the details Windows shows in the file's properties. build.sh fills in the version.
#include <winver.h>

1 ICON "opendmtq.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OPENDMTQ_VERSION_NUMBERS
PRODUCTVERSION OPENDMTQ_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "OpenDMTQ"
      VALUE "FileDescription", "OpenDMTQ server"
      VALUE "FileVersion", OPENDMTQ_VERSION_TEXT
      VALUE "InternalName", "OpenDMTQ"
      VALUE "LegalCopyright", "MIT License, see LICENSE.txt"
      VALUE "OriginalFilename", "OpenDMTQ.exe"
      VALUE "ProductName", "OpenDMTQ"
      VALUE "ProductVersion", OPENDMTQ_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
