# OpenDMTQ settings. `opendmtq setup` writes this file; edit by hand only if you need to.

# Address the app uses: a LAN IPv4 address (host:port for another port than 80), or host:port
# when exposed (./opendmtq expose).
PUBLIC_HOST=192.168.0.10

# The name after the game's title on phones: TECHNIKA Q (name). Empty: the whole address, port included,
# such as TECHNIKA Q (game.example.com:8790). ./opendmtq name sets it and rebuilds the app.
SERVER_NAME=

# Port the server listens on: the port in a LAN PUBLIC_HOST (./opendmtq host sets both), or the
# forwarded port when exposed.
#LISTEN_PORT=80

# The base APK to patch when data/apk/base holds several different clients (a file name there);
# ./opendmtq apk --base <file name> sets it.
#BASE_APK=game.apk

# Admin pages on the main port at /opendmtq/admin/ (yes), or only at their own address below (no; set by
# ./opendmtq expose unless --admin-public).
#ADMIN_ON_PUBLIC_PORT=yes

# The owner's admin account: this ID ("admin" unless set) and ADMIN_PASSWORD, which setup writes. Every other account,
# for the site or with admin rights, is made on the admin pages' Accounts page; nobody makes their own.
#ADMIN_USER=admin

# The admin pages' own address (default: http://localhost:8791/opendmtq/admin/ on this PC only).
#ADMIN_BIND=127.0.0.1
#ADMIN_PORT=8791

# Keep the server running across reboots of Docker: unless-stopped (default: no).
#RESTART=unless-stopped

# Interface to publish the server's port on (default: all).
#BIND_ADDRESS=0.0.0.0

# What this server's containers are called. A second copy of the repository on the same machine gets its own
# name here by itself; the first has none.
#COMPOSE_PROJECT_NAME=opendmtq

# The images to run instead of building them here: a release's, brought to a server without internet with docker load
# (docs/closed-network.md).
#OPENDMTQ_SERVER_IMAGE=ghcr.io/kanggu12/opendmtq-server:1.0.0
#OPENDMTQ_TOOLS_IMAGE=ghcr.io/kanggu12/opendmtq-tools:1.0.0

# on: a new player's broadcast starts on, until you choose on the admin pages' Broadcasts page, where broadcasts are also
# turned on for the server at all (docs/live.md). Default: off.
LIVE_DEFAULT=off
